rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    function isActiveMember() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(memberPath())
        && get(memberPath()).data.active == true;
    }

    function hasRole(roles) {
      return isActiveMember()
        && get(memberPath()).data.role in roles;
    }

    function isOwner() {
      return hasRole(['owner']);
    }

    function canEdit() {
      return hasRole(['owner', 'editor']);
    }

    match /members/{userId} {
      allow get: if signedIn()
        && request.auth.token.email_verified == true
        && (request.auth.uid == userId || isOwner());

      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }

    match /events/{eventId} {
      allow read: if isActiveMember();
      allow create, update, delete: if canEdit();
    }

    match /milestones/{milestoneId} {
      allow read: if isActiveMember();
      allow create, update, delete: if canEdit();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
